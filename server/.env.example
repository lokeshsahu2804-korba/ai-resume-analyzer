# Server Configuration
# NOTE: macOS uses port 5000 for AirPlay. Use 5001 or another free port.
PORT=5001
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5500

# FastAPI Service URL (for inter-service communication in Phase 8)
FASTAPI_URL=http://localhost:8000

# Rate Limiting Configuration (100 requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# MongoDB Database Configuration (MongoDB Atlas Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai-resume-analyzer?retryWrites=true&w=majority

# JWT Authentication Configuration
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# Cloudinary Storage Configuration (Phase 7 - Resume Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Upload Constraints
MAX_FILE_SIZE_MB=5
